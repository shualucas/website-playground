{
  "name": "field-journal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:resume": "node scripts/build-resume-pdf.mjs",
    "prebuild": "npm run build:resume",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:zine": "playwright test --config playwright.zine.config.js",
    "test:listening": "node --test checks/listening.test.mjs",
    "setup": "node scripts/setup.mjs",
    "test:unit": "node --test checks/*.test.mjs",
    "test:ui": "playwright test --project=ui --workers=2",
    "test:3d": "playwright test --project=3d",
    "test:home": "playwright test portfolio.home",
    "test:projects": "playwright test portfolio.projects",
    "test:cartridges": "playwright test portfolio.cartridges",
    "test:resume": "playwright test portfolio.resume",
    "test:camera": "playwright test portfolio.camera",
    "test:flyers": "playwright test portfolio.flyers",
    "test:listening:ui": "playwright test portfolio.listening",
    "review": "node scripts/review.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/three": "^0.186.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2",
    "vite": "^6.1.0"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/staatliches": "^5.3.0",
    "gifuct-js": "^2.1.2",
    "html-to-image": "^1.11.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  }
}
